# UMINATO Email & Notification Settings
# Optional SMTP configuration for live email dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@uminato.com
SMTP_PASS=your-app-password
SMTP_FROM="UMINATO" <info@uminato.com>

# Target email to receive incoming contact submissions
CONTACT_RECEIVER_EMAIL=info@uminato.com
