# UMINATO Email & Notification Settings
# Optional SMTP configuration for live email dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@uminato.com
SMTP_PASS=your-app-password
SMTP_FROM="UMINATO" <info@uminato.com>

# Target email to receive incoming contact submissions
CONTACT_RECEIVER_EMAIL=info@uminato.com

# Unified Google Apps Script Endpoint (Optional / Webhook)
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

